# SentinelID Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=SentinelID
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./sentinelid.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/sentinelid

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# OCR Configuration
# Options: paddleocr, tesseract
OCR_ENGINE=paddleocr

# Risk Engine Weights (must sum to 100)
RISK_WEIGHT_MRZ=20
RISK_WEIGHT_DATABASE=20
RISK_WEIGHT_TAMPER=25
RISK_WEIGHT_FACE=25
RISK_WEIGHT_CONSISTENCY=10

# Risk Thresholds
RISK_THRESHOLD_VERIFIED=35
RISK_THRESHOLD_SUSPICIOUS=65
# Above 65 = HIGH_RISK

# Face Verification
FACE_SIMILARITY_THRESHOLD=0.6

# CORS
FRONTEND_URL=http://localhost:3000

# Processing
PROCESSING_TIMEOUT_SECONDS=60
